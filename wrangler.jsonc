{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Must match the Worker that actually holds the custom domains. Cloudflare
  // named it after the repo *and* the branch when the repository was imported,
  // hence the "-main" suffix — and the workers.dev hostname
  // (hamzash47-github-io-main.newgene26.workers.dev) is what confirms it.
  //
  // Get this wrong and nothing errors: wrangler happily creates a second,
  // separate Worker under the other name and deploys there, leaving
  // hamzash47.com pointed at the original one, still empty.
  "name": "hamzash47-github-io-main",
  "compatibility_date": "2026-08-17",

  // Two routes run code: /api/brief emails the contact form, /api/chat answers
  // visitor questions. Everything else is the static Vite build from ./dist.
  "main": "./worker/index.ts",

  // Workers AI powers the site assistant on /api/chat. A binding, not an API
  // key: nothing to store as a secret, nothing to rotate, and it draws on this
  // account's own free daily allocation.
  "ai": {
    "binding": "AI"
  },

  // Sends the brief to an address already verified on this account, which is
  // the same mailbox the Email Routing rules forward to. Restricting the
  // binding to that one address means a bug here cannot turn the Worker into
  // an open relay pointed at somebody else's inbox.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "hamzash4798@gmail.com"
    }
  ],

  "assets": {
    "directory": "./dist",

    // Assets are served ahead of the Worker by default, so only this path
    // needs to jump the queue. Naming it explicitly also means a future
    // dist/api/... file could never shadow the endpoint.
    "run_worker_first": ["/api/*"],

    // Deliberately NOT "single-page-application".
    //
    // Case studies are hash routes (#/case/<slug>), and a fragment never
    // reaches the server — so "/" is the only real path this site has, next to
    // the static files (sitemap.xml, robots.txt, og-image.png). SPA handling
    // would answer every unknown path with index.html and a 200, turning
    // typos and stale links into soft 404s that a crawler indexes as
    // duplicate homepages. "404-page" keeps them honest.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
